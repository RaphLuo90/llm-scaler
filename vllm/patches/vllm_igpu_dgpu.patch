+            packed = torch.empty(total_numel, dtype=dtype, device=self.device)
+            self._recv_packed(packed, src)
+            offset = 0
+            for key, size, _ in tensor_specs:
+                numel = int(torch.Size(size).numel())
+                tensor = packed.narrow(0, offset, numel).view(size)
+                result[key] = tensor
+                offset += numel
