+                except OneCCLError:
+                    pass
+                buf.registered = False
+            if buf.keep is None and buf.ptr:
+                self.ccl.mem_free(buf.ptr)
+        self._coll_bufs.clear()
+        self._retired_bufs.clear()
+        self.ccl.destroy()
+        super().destroy()
